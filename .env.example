# DatoFlow environment. Every variable has a safe local default.
# `docker compose -f infra/docker-compose.yml up` needs none of these to be set.

# --- Core ---
NODE_ENV=development
# Public URL of the web app. Auth cookies and email links use it.
APP_URL=http://localhost:3000
# URL the web server uses to reach the API (internal network in Docker).
API_URL=http://localhost:4000
API_PORT=4000
WORKER_PORT=4100

# --- Data ---
DATABASE_URL=postgresql://datoflow:datoflow@localhost:5432/datoflow
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Local-only default. Generate a real one for any shared environment: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Google sign-in is hidden when these are unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AES-256-GCM key for stored secrets, 32 bytes as base64. Local-only default.
SECRETS_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRldi1vbmx5LWtleS0wMTIzNDU=

# --- Email: console | resend | smtp ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
# For Mailpit locally: smtp://localhost:1025
SMTP_URL=
EMAIL_FROM=DatoFlow <no-reply@datoflow.local>
# Provider free-tier ceiling. Overflow is queued for the next day.
EMAIL_DAILY_LIMIT=100

# --- Rate limits (requests per minute) ---
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=300

# --- Bot protection: noop | turnstile (Phase 5) ---
CAPTCHA_PROVIDER=noop
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- File storage: local | r2 (Phase 5) ---
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Billing: noop | polar (Phase 6, polar in v1.1) ---
BILLING_PROVIDER=noop
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Observability (off when unset) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
