{
  "name": "@datoflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@datoflow/adapters": "workspace:*",
    "@datoflow/db": "workspace:*",
    "@datoflow/domain": "workspace:*",
    "@datoflow/shared": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "bullmq": "6.7.6",
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  }
