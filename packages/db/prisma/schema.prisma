generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  REP
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FORM
  WEBHOOK
  IMPORT
  REFERRAL
  PAID_SOCIAL
  PAID_SEARCH
  EMAIL
  EVENT
  MANUAL
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum ActorType {
  USER
  WORKFLOW
  SYSTEM
}

enum DuplicateReason {
  EMAIL
  PHONE
  NAME_COMPANY
}

enum DuplicateStatus {
  OPEN
  DISMISSED
}

enum TaskType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

/// Email deliveries move PENDING → SENDING → SENT, or end SKIPPED or FAILED. In-app ones are SENT.
enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

// ---------------------------------------------------------------------------
// Auth-provider tables. Better Auth owns their shape. They are not tenant tables.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMembership[]
  ownedLeads    Lead[]                   @relation("LeadOwner")
  tasks         Task[]                   @relation("TaskAssignee")
  notifications Notification[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  /// Set by the Better Auth organization plugin when the user switches workspace.
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Tenant tables. Each row belongs to exactly one organization.
// Row-level security is enabled on all of them in the migrations.
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  /// Unused by DatoFlow. The Better Auth organization plugin expects the column.
  logo      String?
  /// Unused by DatoFlow. The Better Auth organization plugin expects the column.
  metadata  String?
  timezone  String    @default("Asia/Colombo")
  currency  String    @default("USD")
  /// ISO 3166-1 alpha-2. Phone numbers without a country code are read as this country (LEAD-02).
  country   String    @default("LK")
  settings  Json      @default("{}")
  planCode  String    @default("free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete. Hard delete follows 30 days later.
  deletedAt DateTime?

  memberships   OrganizationMembership[]
  invitations   Invitation[]
  pipelines     Pipeline[]
  auditLogs     AuditLog[]
  leads         Lead[]
  lossReasons   LossReason[]
  tasks         Task[]
  notifications Notification[]
  workflows     Workflow[]
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           Role
  /// A fictional rep from the sample workspace (ORG-04). Never counted as a seat.
  isSample       Boolean  @default(false)
  /// Per-user settings in this workspace, such as saved lead filters (LEAD-05).
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role
  /// SHA-256 of the token. The token itself is only ever in the email.
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  inviterId      String
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@index([organizationId])
}

model PipelineStage {
  id             String    @id @default(uuid())
  organizationId String
  pipelineId     String
  name           String
  order          Int
  slaHours       Int       @default(72)
  kind           StageKind @default(OPEN)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, order])
  @@index([organizationId])
}

/// Append-only. A trigger rejects UPDATE, and DELETE outside an organization purge.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model LossReason {
  id             String  @id @default(uuid())
  organizationId String
  label          String
  active         Boolean @default(true)
  order          Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, label])
}

model Lead {
  id              String     @id @default(uuid())
  organizationId  String
  pipelineId      String
  stageId         String
  /// A user who is a member of the organization, or null for the unassigned pool.
  ownerId         String?
  name            String
  company         String?
  /// As entered, for display.
  email           String?
  emailNormalized String?
  /// As entered, for display.
  phone           String?
  phoneE164       String?
  /// lower(name)|lower(company), for duplicate matching. Null without a company.
  nameCompanyKey  String?
  source          LeadSource @default(MANUAL)
  priority        Priority   @default(NORMAL)
  dealValue       Decimal?   @db.Decimal(14, 2)
  currency        String
  notes           String?
  /// utm_source, utm_medium, utm_campaign, utm_term, utm_content.
  utm             Json?
  lossReasonId    String?
  isSample        Boolean    @default(false)
  createdById     String?
  stageEnteredAt  DateTime   @default(now())
  /// Last activity that counts as following up. Drives the stage SLA.
  lastActivityAt  DateTime   @default(now())
  /// lastActivityAt plus the stage SLA, for open leads. Null when closed.
  slaDueAt        DateTime?
  /// Due time of the earliest open next step. Null for closed or archived leads (TASK-03).
  nextStepDueAt   DateTime?
  /// When the stuck-lead radar flagged the lead. Cleared when it recovers.
  stuckAt         DateTime?
  /// Lower-case labels. Workflows can add or remove them (WF-04).
  tags            String[]   @default([])
  closedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage                 PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner                 User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lossReason            LossReason?     @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities            LeadActivity[]
  stageHistory          StageHistory[]
  duplicatesAsLead      LeadDuplicate[] @relation("DuplicateLead")
  duplicatesAsCandidate LeadDuplicate[] @relation("DuplicateCandidate")
  tasks                 Task[]

  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneE164])
  @@index([organizationId, createdAt])
  @@index([organizationId, nameCompanyKey])
  @@index([organizationId, slaDueAt])
  @@index([organizationId, nextStepDueAt])
}

/// A task on a lead (TASK-01). An open one with a due time and an assignee is a next step.
model Task {
  id              String     @id @default(uuid())
  organizationId  String
  leadId          String
  title           String
  type            TaskType
  dueAt           DateTime
  priority        Priority   @default(NORMAL)
  /// A member of the organization. Null only when the person's account was deleted.
  assigneeId      String?
  status          TaskStatus @default(OPEN)
  completedAt     DateTime?
  /// The due time for which `task.deadline_reached` was raised, so each deadline raises one event.
  deadlineEventAt DateTime?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, assigneeId, status, dueAt])
  @@index([organizationId, leadId, status])
  @@index([status, dueAt])
}

/// In-app notifications (NOT-01), and the delivery record of every reminder and digest.
/// `dedupeKey` makes each one happen once (TASK-04: task + type + due time).
model Notification {
  id             String              @id @default(uuid())
  organizationId String
  /// The member it is for. Null only for a workflow email to a lead, which uses `toAddress`.
  userId         String?
  /// Email only: an address outside the workspace, such as a lead's (WF-04).
  toAddress      String?
  kind           String
  channel        NotificationChannel
  payload        Json                @default("{}")
  dedupeKey      String?             @unique
  status         DeliveryStatus      @default(SENT)
  /// Email only: not sent before this time (the daily budget queues overflow to the next day).
  sendAfter      DateTime            @default(now())
  /// Email only: after this time it is no longer useful, such as a reminder for a step now due.
  staleAt        DateTime?
  claimedAt      DateTime?
  sentAt         DateTime?
  attempts       Int                 @default(0)
  error          String?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([status, sendAfter])
}

/// A possible duplicate. Shown with a link; never merged automatically (LEAD-03).
model LeadDuplicate {
  id             String          @id @default(uuid())
  organizationId String
  leadId         String
  candidateId    String
  reason         DuplicateReason
  status         DuplicateStatus @default(OPEN)
  createdAt      DateTime        @default(now())

  lead      Lead @relation("DuplicateLead", fields: [leadId], references: [id], onDelete: Cascade)
  candidate Lead @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([leadId, candidateId])
  @@index([organizationId, candidateId])
}

model LeadActivity {
  id             String    @id @default(uuid())
  organizationId String
  leadId         String
  type           String
  actorType      ActorType
  actorId        String?
  /// The actor's name when the activity happened, such as a workflow's name.
  actorLabel     String?
  payload        Json      @default("{}")
  occurredAt     DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, occurredAt])
}

model StageHistory {
  id             String   @id @default(uuid())
  organizationId String
  leadId         String
  fromStageId    String?
  toStageId      String
  actorId        String?
  enteredAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, toStageId, enteredAt])
  @@index([leadId])
}

/// Written in the same transaction as the change it describes. The worker publishes it to BullMQ.
/// `depth` counts the workflow runs between a person's change and this event; `causationId` is
/// the run that raised it (WF-09).
model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  type           String
  aggregateType  String
  aggregateId    String
  payload        Json
  depth          Int       @default(0)
  causationId    String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([organizationId, createdAt])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SKIPPED
  CANCELLED
  FAILED
  DEAD
}

enum StepStatus {
  SUCCEEDED
  FAILED
}

/// A workflow (WF-01). Its rules live in immutable versions; the active one runs.
model Workflow {
  id               String         @id @default(uuid())
  organizationId   String
  name             String
  status           WorkflowStatus @default(DRAFT)
  activeVersionId  String?
  latestVersion    Int            @default(0)
  /// Round-robin picks made so far (WF-04).
  roundRobinCursor Int            @default(0)
  isSample         Boolean        @default(false)
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  executions   WorkflowExecution[]

  @@index([organizationId, status])
}

/// One saved definition of a workflow. Never updated: a database trigger refuses it (WF-01).
model WorkflowVersion {
  id             String   @id @default(uuid())
  organizationId String
  workflowId     String
  version        Int
  trigger        String
  conditions     Json
  actions        Json
  createdById    String?
  createdAt      DateTime @default(now())

  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([workflowId, version])
  @@index([organizationId, trigger])
}

/// One run of one workflow version for one event. Unique per version and event (WF-07).
model WorkflowExecution {
  id             String          @id @default(uuid())
  organizationId String
  workflowId     String
  versionId      String
  eventId        String
  eventType      String
  /// The lead the event is about. Not a foreign key: the log outlives deleted sample leads.
  leadId         String?
  status         ExecutionStatus
  /// Attempts started, including one cut short by a worker that stopped.
  attempt        Int             @default(0)
  /// Depth of the triggering event (WF-09).
  depth          Int             @default(0)
  isSample       Boolean         @default(false)
  skipReason     String?
  error          String?
  /// VALIDATION, PERMISSION, NOT_FOUND or TRANSIENT.
  errorKind      String?
  nextAttemptAt  DateTime?
  /// When the running attempt started. A stale claim belongs to a worker that stopped.
  claimedAt      DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  manualRetries  Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workflow Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version  WorkflowVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  steps    WorkflowExecutionStep[]

  @@unique([versionId, eventId])
  @@index([organizationId, createdAt])
  @@index([organizationId, workflowId, createdAt])
  @@index([organizationId, status])
  @@index([status, nextAttemptAt])
}

/// One action of a run. Written in the same transaction as the action's effect, so a step that
/// succeeded is never repeated (WF-07: keyed by execution and step index).
model WorkflowExecutionStep {
  id             String     @id @default(uuid())
  organizationId String
  executionId    String
  stepIndex      Int
  actionType     String
  status         StepStatus
  /// The attempt that wrote this result.
  attempt        Int
  result         Json?
  error          String?
  finishedAt     DateTime   @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepIndex])
  @@index([organizationId, executionId])
}
