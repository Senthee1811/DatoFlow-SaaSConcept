generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  REP
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FORM
  WEBHOOK
  IMPORT
  REFERRAL
  PAID_SOCIAL
  PAID_SEARCH
  EMAIL
  EVENT
  MANUAL
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum ActorType {
  USER
  WORKFLOW
  SYSTEM
}

enum DuplicateReason {
  EMAIL
  PHONE
  NAME_COMPANY
}

enum DuplicateStatus {
  OPEN
  DISMISSED
}

// ---------------------------------------------------------------------------
// Auth-provider tables. Better Auth owns their shape. They are not tenant tables.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMembership[]
  ownedLeads  Lead[]                   @relation("LeadOwner")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  /// Set by the Better Auth organization plugin when the user switches workspace.
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Tenant tables. Each row belongs to exactly one organization.
// Row-level security is enabled on all of them in the migrations.
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  /// Unused by DatoFlow. The Better Auth organization plugin expects the column.
  logo      String?
  /// Unused by DatoFlow. The Better Auth organization plugin expects the column.
  metadata  String?
  timezone  String    @default("Asia/Colombo")
  currency  String    @default("USD")
  /// ISO 3166-1 alpha-2. Phone numbers without a country code are read as this country (LEAD-02).
  country   String    @default("LK")
  settings  Json      @default("{}")
  planCode  String    @default("free")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete. Hard delete follows 30 days later.
  deletedAt DateTime?

  memberships OrganizationMembership[]
  invitations Invitation[]
  pipelines   Pipeline[]
  auditLogs   AuditLog[]
  leads       Lead[]
  lossReasons LossReason[]
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           Role
  /// A fictional rep from the sample workspace (ORG-04). Never counted as a seat.
  isSample       Boolean  @default(false)
  /// Per-user settings in this workspace, such as saved lead filters (LEAD-05).
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role
  /// SHA-256 of the token. The token itself is only ever in the email.
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  inviterId      String
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@index([organizationId])
}

model PipelineStage {
  id             String    @id @default(uuid())
  organizationId String
  pipelineId     String
  name           String
  order          Int
  slaHours       Int       @default(72)
  kind           StageKind @default(OPEN)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, order])
  @@index([organizationId])
}

/// Append-only. A trigger rejects UPDATE, and DELETE outside an organization purge.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model LossReason {
  id             String  @id @default(uuid())
  organizationId String
  label          String
  active         Boolean @default(true)
  order          Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, label])
}

model Lead {
  id              String     @id @default(uuid())
  organizationId  String
  pipelineId      String
  stageId         String
  /// A user who is a member of the organization, or null for the unassigned pool.
  ownerId         String?
  name            String
  company         String?
  /// As entered, for display.
  email           String?
  emailNormalized String?
  /// As entered, for display.
  phone           String?
  phoneE164       String?
  /// lower(name)|lower(company), for duplicate matching. Null without a company.
  nameCompanyKey  String?
  source          LeadSource @default(MANUAL)
  priority        Priority   @default(NORMAL)
  dealValue       Decimal?   @db.Decimal(14, 2)
  currency        String
  notes           String?
  /// utm_source, utm_medium, utm_campaign, utm_term, utm_content.
  utm             Json?
  lossReasonId    String?
  isSample        Boolean    @default(false)
  createdById     String?
  stageEnteredAt  DateTime   @default(now())
  /// Last activity that counts as following up. Drives the stage SLA.
  lastActivityAt  DateTime   @default(now())
  /// lastActivityAt plus the stage SLA, for open leads. Null when closed.
  slaDueAt        DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage                 PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner                 User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lossReason            LossReason?     @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities            LeadActivity[]
  stageHistory          StageHistory[]
  duplicatesAsLead      LeadDuplicate[] @relation("DuplicateLead")
  duplicatesAsCandidate LeadDuplicate[] @relation("DuplicateCandidate")

  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneE164])
  @@index([organizationId, createdAt])
  @@index([organizationId, nameCompanyKey])
  @@index([organizationId, slaDueAt])
}

/// A possible duplicate. Shown with a link; never merged automatically (LEAD-03).
model LeadDuplicate {
  id             String          @id @default(uuid())
  organizationId String
  leadId         String
  candidateId    String
  reason         DuplicateReason
  status         DuplicateStatus @default(OPEN)
  createdAt      DateTime        @default(now())

  lead      Lead @relation("DuplicateLead", fields: [leadId], references: [id], onDelete: Cascade)
  candidate Lead @relation("DuplicateCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([leadId, candidateId])
  @@index([organizationId, candidateId])
}

model LeadActivity {
  id             String    @id @default(uuid())
  organizationId String
  leadId         String
  type           String
  actorType      ActorType
  actorId        String?
  /// The actor's name when the activity happened, such as a workflow's name.
  actorLabel     String?
  payload        Json      @default("{}")
  occurredAt     DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, occurredAt])
}

model StageHistory {
  id             String   @id @default(uuid())
  organizationId String
  leadId         String
  fromStageId    String?
  toStageId      String
  actorId        String?
  enteredAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, toStageId, enteredAt])
  @@index([leadId])
}

/// Written in the same transaction as the change it describes. The worker publishes it (Phase 4).
model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  type           String
  aggregateType  String
  aggregateId    String
  payload        Json
  depth          Int       @default(0)
  causationId    String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([organizationId, createdAt])
}
